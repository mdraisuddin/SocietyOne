# Copy to server/.env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://societyone:societyone@localhost:5432/societyone_dev
# 32+ random bytes, e.g. `openssl rand -hex 32`. Used to sign visitor QR passes.
APP_SECRET=change-me-to-a-long-random-string
# Comma-separated allowed browser origins (dev web server)
CORS_ORIGINS=http://localhost:5173
# Where uploaded files are stored (local disk adapter)
UPLOAD_DIR=./uploads
# Expose OTPs / reset tokens in API responses for demo environments ONLY.
DEMO_MODE=true
# Optional Web Push (generate with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@societyone.in
